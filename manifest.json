{
  "manifest_version": 3,
  "name": "Ember — Bookmark Manager",
  "short_name": "Ember",
  "version": "1.0.0",
  "description": "A local-only bookmark manager: lines (collections), tags, notes, previews and fast search. Nothing leaves your machine.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to Ember",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting",
    "bookmarks",
    "favicon"
  ],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["<all_urls>"],
  "omnibox": { "keyword": "em" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current page"
    },
    "open-ember": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Open the Ember library"
    }
  }
}
