{
  "manifest_version": 3,
  "name": "Linemark — Bookmark Manager",
  "short_name": "Linemark",
  "version": "1.0.0",
  "description": "Bookmarks on colour-coded lines, with tags, notes, full-text search and a broken-link checker. Local by default; sync optional.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to Linemark",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting",
    "bookmarks",
    "favicon"
  ],
  "optional_permissions": ["tabs", "identity"],
  "optional_host_permissions": ["<all_urls>"],
  "oauth2": {
    "client_id": "YOUR_CHROME_EXTENSION_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  },
  "omnibox": { "keyword": "lm" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current page"
    },
    "open-linemark": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open the Linemark library"
    }
  }
}
